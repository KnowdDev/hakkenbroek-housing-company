#!/bin/sh
# Block commits that contain hardcoded secrets
# Patterns are one-per-line so spaces inside regexes are not word-split.
BLOCKED_PATTERNS='postgresql://[^[:space:]]+@[^[:space:]]+
postgres://[^[:space:]]+@[^[:space:]]+
npg_[A-Za-z0-9]{20,}
-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----
AKIA[0-9A-Z]{16}
r2_access_key_id|r2_secret_access_key
vault_master_key|mcp_api_key'

staged_files=$(git diff --cached --name-only | grep -v '^\.husky/' || true)
if [ -z "$staged_files" ]; then
  exit 0
fi

echo "$BLOCKED_PATTERNS" | while IFS= read -r pattern; do
  [ -z "$pattern" ] && continue
  matches=$(git diff --cached -- . ':!.husky/' | grep -inE "$pattern" || true)
  if [ -n "$matches" ]; then
    echo "❌ BLOCKED: Potential secret detected in staged changes."
    echo "Pattern: $pattern"
    echo "$matches"
    echo ""
    echo "If this is a false positive, use: git commit --no-verify"
    exit 1
  fi
done

status=$?
if [ "$status" -ne 0 ]; then
  exit "$status"
fi

echo "✅ No secrets detected in staged files."
