{
  "_comment": "Copy this into ~/.codeium/windsurf/mcp_config.json and fill in your DATABASE_URL and MCP_API_KEY",
  "mcpServers": {
    "hakkenbroek-stdio": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/hakkenbroek-housing/mcp/stdio-server/dist/index.js"
      ],
      "env": {
        "DATABASE_URL": "YOUR_DATABASE_URL_HERE",
        "DB_SSL": "true",
        "SERVER_NAME": "hakkenbroek-housing-stdio",
        "SERVER_VERSION": "2.0.0",
        "PROTOCOL_VERSION": "2024-11-05"
      }
    },
    "hakkenbroek-http": {
      "url": "https://hakkenbroek-mcp.runs-one.workers.dev",
      "headers": {
        "x-api-key": "YOUR_MCP_API_KEY_HERE"
      }
    }
  }
}
